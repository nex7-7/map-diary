{
  "name": "@map-diary/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && next build && node scripts/finish-export.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "pnpm build && wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:staging": "pnpm build && wrangler deploy --env staging",
    "test": "vitest run",
    "map:dev": "scripts/dev-map-file.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/redaction": "5.3.0",
    "@fontsource/redaction-35": "5.3.0",
    "@fontsource/redaction-50": "5.3.0",
    "@map-diary/crypto": "workspace:*",
    "@map-diary/sync": "workspace:*",
    "@protomaps/basemaps": "5.7.2",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "maplibre-gl": "6.12.0",
    "next": "16.4.2",
    "pmtiles": "4.5.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "fake-indexeddb": "6.2.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
