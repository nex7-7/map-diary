{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "map-diary-web",
  "compatibility_date": "2026-10-01",
  // Static assets only, with no Worker script: page requests are served from the asset store
  // and never use Worker CPU. Headers come from out/_headers (scripts/finish-export.mjs).
  "assets": {
    "directory": "out",
    // /place serves out/place.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  // The API Worker serves map.snehilsinha.com/api/* through a route that runs
  // before this Custom Domain; everything else is the web app.
  "routes": [{ "pattern": "map.snehilsinha.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "env": {
    // Pre-launch testing copy; the API Worker's `staging` env serves its /api/*.
    "staging": {
      "name": "map-diary-web-staging",
      "routes": [{ "pattern": "staging.map.snehilsinha.com", "custom_domain": true }]
    }
  }
}
