{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "map-diary-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": false,
  // The API Worker serves map.snehilsinha.com/api/* through a route that runs
  // before this Custom Domain; everything else is the web app.
  "routes": [{ "pattern": "map.snehilsinha.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "env": {
    // Pre-launch testing copy; the API Worker's `staging` env serves its /api/*.
    "staging": {
      "name": "map-diary-web-staging",
      "routes": [{ "pattern": "staging.map.snehilsinha.com", "custom_domain": true }]
    }
  }
}
