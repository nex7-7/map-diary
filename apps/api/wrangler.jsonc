{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "map-diary-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "upload_source_maps": true,
  "minify": true,
  "workers_dev": false,
  // The web app owns map.snehilsinha.com as a Custom Domain; this route runs in
  // front of it for /api only, so both share one origin.
  "routes": [{ "pattern": "map.snehilsinha.com/api/*", "zone_name": "snehilsinha.com" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "map-diary",
      "database_id": "4362f68c-cca6-412f-a8fa-455e4d0db8d1",
      "migrations_dir": "migrations"
    }
  ],
  // Mumbai PMTiles map; the file lives at the object key "mumbai.pmtiles".
  "r2_buckets": [{ "binding": "TILES", "bucket_name": "map-diary-tiles" }],
  // Expires stale resolver jobs. No other scheduled work.
  "triggers": { "crons": ["17 * * * *"] },
  // Passphrase sign-in lookups per client IP, per Cloudflare location.
  "ratelimits": [{ "name": "BACKUP_LOOKUPS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Bearer token for the resolver (Claude's scheduled task). Set with
  // `wrangler secret put RESOLVER_TOKEN`; tests bind a fixed value.
  "secrets": { "required": ["RESOLVER_TOKEN"] },
  "observability": { "enabled": true },
  "env": {
    // A full copy for pre-launch testing on its own subdomain and empty database, so
    // tests and wipes never touch production. Pairs with the web Worker's `staging` env.
    "staging": {
      "name": "map-diary-api-staging",
      "routes": [{ "pattern": "staging.map.snehilsinha.com/api/*", "zone_name": "snehilsinha.com" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "map-diary-staging",
          "database_id": "406992d3-89ea-45df-89d6-1eb5061fe2f1",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "TILES", "bucket_name": "map-diary-tiles" }],
      "secrets": { "required": ["RESOLVER_TOKEN"] },
      "ratelimits": [{ "name": "BACKUP_LOOKUPS", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }],
      "triggers": { "crons": ["17 * * * *"] }
    }
  }
}
